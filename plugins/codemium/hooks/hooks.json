{
  "description": "Codemium Project Brain lifecycle enforcement and retrieval fast path for repository-bound Codex tasks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','project_brain_dispatch.py'), run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','project_brain_dispatch.py'), run_name='__main__')\"",
            "timeout": 30,
            "statusMessage": "Preparing Codemium Project Brain",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','project_brain_dispatch.py'), run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','project_brain_dispatch.py'), run_name='__main__')\"",
            "timeout": 30,
            "statusMessage": "Checking Codemium Project Brain persistence"
          }
        ]
      }
    ]
  }
}
